    "constraints": ["board.length == 9", "board[i].length == 9", "board[i][j] est un chiffre 1-9 ou '.'"]
  },
  "49": {
    "description": "Regroupez les anagrammes ensemble. Un anagramme est un mot formé en réarrangeant les lettres d'un autre mot.",
    "examples": [
      {"input": "strs = [\"eat\", \"tea\", \"tan\", \"ate\", \"nat\", \"bat\"]", "output": "[[\"bat\"], [\"nat\", \"tan\"], [\"ate\", \"eat\", \"tea\"]]", "explanation": "Les anagrammes sont regroupés"},
