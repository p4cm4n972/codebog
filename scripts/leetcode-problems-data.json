{
  "1": {
    "description": "Étant donné un tableau d'entiers et un entier cible, retournez les indices des deux nombres dont la somme est égale à la cible. Chaque entrée a exactement une solution, et vous ne pouvez pas utiliser le même élément deux fois.",
    "examples": [
      {"input": "nums = [2, 7, 11, 15], target = 9", "output": "[0, 1]", "explanation": "nums[0] + nums[1] = 2 + 7 = 9"},
      {"input": "nums = [3, 2, 4], target = 6", "output": "[1, 2]", "explanation": "nums[1] + nums[2] = 2 + 4 = 6"},
      {"input": "nums = [3, 3], target = 6", "output": "[0, 1]", "explanation": "nums[0] + nums[1] = 3 + 3 = 6"}
    ],
    "constraints": ["2 ≤ nums.length ≤ 10⁴", "-10⁹ ≤ nums[i] ≤ 10⁹", "-10⁹ ≤ target ≤ 10⁹", "Exactement une solution existe"]
  },
  "11": {
    "description": "Étant donné n lignes verticales de hauteurs données, trouvez deux lignes qui, avec l'axe x, forment un conteneur contenant le plus d'eau possible.",
    "examples": [
      {"input": "height = [1, 8, 6, 2, 5, 4, 8, 3, 7]", "output": "49", "explanation": "Les lignes aux indices 1 et 8 (hauteurs 8 et 7) forment le plus grand conteneur"},
      {"input": "height = [1, 1]", "output": "1", "explanation": "Un seul choix possible"}
    ],
    "constraints": ["2 ≤ n ≤ 10⁵", "0 ≤ height[i] ≤ 10⁴"]
  },
  "13": {
    "description": "Convertissez un nombre romain en entier. Les symboles romains sont I(1), V(5), X(10), L(50), C(100), D(500), M(1000). Quand un symbole plus petit précède un plus grand, on soustrait.",
    "examples": [
      {"input": "s = \"III\"", "output": "3", "explanation": "III = 3"},
      {"input": "s = \"LVIII\"", "output": "58", "explanation": "L = 50, V = 5, III = 3 → 58"},
      {"input": "s = \"MCMXCIV\"", "output": "1994", "explanation": "M=1000, CM=900, XC=90, IV=4 → 1994"}
    ],
    "constraints": ["1 ≤ s.length ≤ 15", "s contient uniquement I, V, X, L, C, D, M", "1 ≤ résultat ≤ 3999"]
  },
  "14": {
    "description": "Trouvez le plus long préfixe commun parmi un tableau de chaînes. Si aucun préfixe commun n'existe, retournez une chaîne vide.",
    "examples": [
      {"input": "strs = [\"flower\", \"flow\", \"flight\"]", "output": "\"fl\"", "explanation": "Le préfixe commun le plus long est \"fl\""},
      {"input": "strs = [\"dog\", \"racecar\", \"car\"]", "output": "\"\"", "explanation": "Aucun préfixe commun"}
    ],
    "constraints": ["1 ≤ strs.length ≤ 200", "0 ≤ strs[i].length ≤ 200", "strs[i] contient uniquement des lettres minuscules"]
  },
  "15": {
    "description": "Trouvez tous les triplets uniques dans le tableau dont la somme est égale à zéro.",
    "examples": [
      {"input": "nums = [-1, 0, 1, 2, -1, -4]", "output": "[[-1, -1, 2], [-1, 0, 1]]", "explanation": "Deux triplets dont la somme = 0"},
      {"input": "nums = [0, 1, 1]", "output": "[]", "explanation": "Aucun triplet valide"},
      {"input": "nums = [0, 0, 0]", "output": "[[0, 0, 0]]", "explanation": "Seul triplet possible"}
    ],
    "constraints": ["3 ≤ nums.length ≤ 3000", "-10⁵ ≤ nums[i] ≤ 10⁵"]
  },
  "20": {
    "description": "Déterminez si une chaîne de parenthèses est valide. Chaque parenthèse ouvrante doit avoir sa correspondante fermante dans le bon ordre.",
    "examples": [
      {"input": "s = \"()\"", "output": "true", "explanation": "Parenthèses correctement fermées"},
      {"input": "s = \"()[]{}\"", "output": "true", "explanation": "Trois paires correctes"},
      {"input": "s = \"(]\"", "output": "false", "explanation": "Mauvaise correspondance"}
    ],
    "constraints": ["1 ≤ s.length ≤ 10⁴", "s contient uniquement ()[]{}"]
  },
  "21": {
    "description": "Fusionnez deux listes chaînées triées en une seule liste triée.",
    "examples": [
      {"input": "list1 = [1, 2, 4], list2 = [1, 3, 4]", "output": "[1, 1, 2, 3, 4, 4]", "explanation": "Fusion triée des deux listes"},
      {"input": "list1 = [], list2 = []", "output": "[]", "explanation": "Deux listes vides"},
      {"input": "list1 = [], list2 = [0]", "output": "[0]", "explanation": "Une liste vide"}
