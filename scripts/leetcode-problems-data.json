      {"input": "board = [[\"5\",\"3\",...], ...]", "output": "true", "explanation": "Grille valide : pas de doublons dans les lignes, colonnes et sous-grilles"},
      {"input": "board (avec doublon dans colonne)", "output": "false", "explanation": "Un chiffre est répété dans une colonne"}
