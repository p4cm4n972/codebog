{
  "name": "codebog-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:piscine": "ts-node -r dotenv/config scripts/sync-piscine.ts dotenv_config_path=.env.local",
    "setup:submissions": "ts-node -r dotenv/config scripts/setup-submissions.ts dotenv_config_path=.env.local",
    "migrate:testcode": "ts-node -r dotenv/config scripts/add-testcode-attribute.ts dotenv_config_path=.env.local",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "setup:gems": "ts-node -r dotenv/config scripts/setup-gems-collections.ts dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@wasmer/sdk": "^0.10.0",
    "appwrite": "^21.5.0",
    "isolated-vm": "^5.0.1",
    "next": "16.1.1",
    "node-appwrite": "^21.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "stripe": "^20.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "simple-git": "^3.30.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
